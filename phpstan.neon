includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 5
    treatPhpDocTypesAsCertain: false

    paths:
        - app
        - config
        - bootstrap
        - database/factories
        - routes

    excludePaths:
        - vendor/*
        - node_modules/*
        - storage/*
        - bootstrap/cache/*